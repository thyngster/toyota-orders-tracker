{
    "manifest_version": 3,
    "name": "Toyota Advanced Order Tracker",
    "description": "Toyota Advanced Order Tracker",
    "version": "1.0.1",
    "author": "David Vallejo",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [{
        "matches": ["*://*.toyota-europe.com/*", "*://*.toyota.es/*"], 
        "js": ["content.js"],
        "run_at": "document_start"
    }],
    "web_accessible_resources": [
        {
            "resources": ["injected.js"],
            "matches": ["<all_urls>"]
        }
    ]
}
